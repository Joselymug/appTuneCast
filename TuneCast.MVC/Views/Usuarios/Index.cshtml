USUARIOS-INDEX
@model IEnumerable<TuneCastModelo.Usuario>
@{
    ViewData["Title"] = "Usuarios";
}

<div class="data-container">
    <h1>GESTIÓN DE USUARIOS</h1>

    <div class="actions-bar">
        <a asp-action="Create" class="create-btn">CREAR NUEVO USUARIO</a>
    </div>

    <table class="data-table">
        <thead>
            <tr>
                <th>#</th>
                <th>NOMBRE</th>
                <th>EMAIL</th>
                <th>ROL</th>
                <th>ACCIONES</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Nombre</td>
                        <td>@item.Email</td>
                        <td>
                            <span class="role-badge @(item.Rol == "Admin" ? "admin-badge" : "user-badge")">
                                @item.Rol
                            </span>
                        </td>
                        <td class="action-buttons">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn edit-btn">EDITAR</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="action-btn details-btn">DETALLES</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="action-btn delete-btn">ELIMINAR</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="empty-message">
                        No hay usuarios registrados
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>