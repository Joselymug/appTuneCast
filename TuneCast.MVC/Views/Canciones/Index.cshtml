@model IEnumerable<TuneCastModelo.Cancion>

@{
    ViewData["Title"] = "Canciones";
}

<div class="data-container">
    <h1>GESTIÓN DE CANCIONES</h1>

    <div class="actions-bar">
        <a asp-action="Create" class="create-btn">CREAR NUEVA CANCIÓN</a>
    </div>

    <table class="data-table">
        <thead>
            <tr>
                <th>#</th>
                <th>TÍTULO</th>
                <th>GENERO</th>
                <th>ACCIONES</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Titulo</td>
                        <td>@item.Genero</td>
                        <td class="action-buttons">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn edit-btn">EDITAR</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="action-btn details-btn">DETALLES</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="action-btn delete-btn">ELIMINAR</a>
                            <a asp-action="AgregarPlaylist" asp-route-id="@item.Id" class="action-btn add-playlist-btn">AGREGAR A PLAYLIST</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="empty-message">
                        No hay canciones registradas
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>