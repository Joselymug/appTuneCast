<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TuneCast.MVC</title>

    <!-- Bootstrap y estilos -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ValidacionDatos.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Pagos.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/TuneCast.MVC.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/editar-perfil.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/perfil-editable.css" asp-append-version="true" />

    <!-- Sección para estilos específicos de cada vista -->
    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="layout-body">
    <div class="layout-container">

        <!-- Barra de navegación fija corregida -->
        <header class="layout-header">
            <nav class="navbar navbar-expand-lg navbar-dark bg-dark-purple fixed-top">
                <div class="container-fluid">
                    <!-- Logo/Brand -->
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="fas fa-music"></i> TuneCast.MVC
                    </a>

                    <!-- Botón para móvil -->
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                            aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <!-- Contenido de navegación -->
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <!-- Barra de búsqueda centrada -->
                        <div class="navbar-search mx-auto">
                            <div class="search-container">
                                <form asp-controller="Home" asp-action="Index" method="get" style="display: inline;">
                                    <input type="text" name="q" class="search-bar" placeholder="¿Qué quieres reproducir?" value="@ViewData["SearchQuery"]">
                                </form>
                                <i class="fas fa-search search-icon"></i>
                            </div>
                        </div>

                        <!-- Menú de usuario a la derecha -->
                        <ul class="navbar-nav ms-auto">
                            <!-- Enlace Premium -->
                            <li class="nav-item">
                                <a class="nav-link premium-link" asp-controller="Planes" asp-action="Index">
                                    <i class="fas fa-crown"></i> Vuelvete Premium
                                </a>
                            </li>

                            <!-- Mi Perfil (solo si está autenticado) -->
                            @if (User.Identity.IsAuthenticated)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Account" asp-action="Perfil">
                                        <i class="fas fa-user"></i> Mi Perfil
                                    </a>
                                </li>
                            }

                            <!-- Autenticación -->
                            @if (!User.Identity.IsAuthenticated)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Account" asp-action="Register">
                                        <i class="fas fa-user-plus"></i> Registrarse
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link btn-login" asp-controller="Account" asp-action="Login">
                                        <i class="fas fa-sign-in-alt"></i> Iniciar Sesión
                                    </a>
                                </li>
                            }
                            else
                            {
                                <!-- Dropdown de usuario -->
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle user-dropdown" href="#" role="button"
                                       data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fas fa-user-circle"></i> @User.Identity.Name
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a class="dropdown-item" asp-controller="Account" asp-action="Perfil">
                                                <i class="fas fa-user"></i> Mi Perfil
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Planes" asp-action="Index">
                                                <i class="fas fa-crown"></i> Planes
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="dropdown-item logout-btn">
                                                    <i class="fas fa-sign-out-alt"></i> Cerrar Sesión
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <!-- Contenido principal con padding superior para navbar fija -->
        <main class="layout-main">
            <div class="content-wrapper">
                @RenderBody()
            </div>
        </main>

        <!-- Pie de página -->
        <footer class="layout-footer">
            <div class="footer-content">
                <span>&copy; 2025 - TuneCast.MVC - Tu plataforma de música favorita</span>
            </div>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Sección para scripts específicos de cada vista -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>