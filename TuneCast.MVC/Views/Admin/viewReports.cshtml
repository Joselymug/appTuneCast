<!-- Lista de Planes -->
<h2>Planes</h2>
<table class="table">
    <thead>
        <tr>
            <th>Nombre del Plan</th>
            <th>Precio</th>
            <th>Descripción</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var plan in Model.Planes)
        {
            <tr>
                <td>@plan.Nombre</td>
                <td>@plan.Precio</td>
                <td>@plan.Descripcion</td>
            </tr>
        }
    </tbody>
</table>
