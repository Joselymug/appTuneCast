@model IEnumerable<TuneCastModelo.Suscripcion>
@{
    ViewData["Title"] = "Suscripciones";
}

<div class="data-container">
    <h1>GESTIÓN DE SUSCRIPCIONES</h1>

    <div class="actions-bar">
        <a asp-action="Create" class="create-btn">CREAR NUEVA SUSCRIPCIÓN</a>
    </div>

    <table class="data-table">
        <thead>
            <tr>
                <th>#</th>
                <th>FECHA INICIO</th>
                <th>FECHA FIN</th>
                <th>ESTADO</th>
                <th>USUARIO</th>
                <th>PLAN</th>
                <th>ACCIONES</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                        <td>@item.FechaFin.ToString("dd/MM/yyyy")</td>
                        <td>
                            <span class="status-badge @(item.Activa ? "active-badge" : "inactive-badge")">
                                @(item.Activa ? "ACTIVA" : "INACTIVA")
                            </span>
                        </td>
                        <td>@item.UsuarioId</td>
                        <td>@item.PlanId</td>
                        <td class="action-buttons">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn edit-btn">EDITAR</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="action-btn details-btn">DETALLES</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="action-btn delete-btn">ELIMINAR</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="empty-message">
                        No hay suscripciones registradas
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>