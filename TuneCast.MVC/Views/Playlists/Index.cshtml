@model IEnumerable<TuneCastModelo.Playlist>
@{
    ViewData["Title"] = "Playlists";
}

<div class="data-container">
    <h1>GESTIÓN DE PLAYLISTS</h1>

    <div class="actions-bar">
        <a asp-action="Create" class="create-btn">CREAR NUEVA PLAYLIST</a>
    </div>

    <table class="data-table">
        <thead>
            <tr>
                <th>#</th>
                <th>NOMBRE</th>
                <th>USUARIO</th>
                <th>ACCIONES</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Nombre</td>
                        <td>@item.UsuarioId</td>
                        <td class="action-buttons">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn edit-btn">EDITAR</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="action-btn details-btn">DETALLES</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="action-btn delete-btn">ELIMINAR</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="empty-message">
                        No hay playlists registradas
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>