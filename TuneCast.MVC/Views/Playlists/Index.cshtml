@model IEnumerable<TuneCastModelo.Playlist>

@{
    ViewData["Title"] = "Lista de Playlists";
}

<div class="container">
    <h1 class="text-center my-4">Lista de Playlists</h1>

    <div class="d-flex justify-content-between mb-3">
        <a asp-action="Create" class="btn btn-success">Crear Nueva Playlist</a>
    </div>

    <table class="table table-striped table-bordered">
        <thead class="thead-dark">
            <tr>
                <th>#</th>
                <th>Nombre</th>
                <th>Usuario</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Nombre</td>
                    <td>@item.UsuarioId</td>
                    <td>
                        <a href="@Url.Action("Edit", "Playlist", new { id = item.Id })" class="btn btn-primary btn-sm">Editar</a>
                        <a href="@Url.Action("Details", "Playlist", new { id = item.Id })" class="btn btn-info btn-sm">Detalles</a>
                        <a href="@Url.Action("Delete", "Playlist", new { id = item.Id })" class="btn btn-danger btn-sm">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
